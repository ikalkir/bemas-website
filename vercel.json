{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://bemasagrega.com/$1",
      "statusCode": 301,
      "has": [
        {
          "type": "host",
          "value": "bemasmining.com"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "https://bemasagrega.com/$1",
      "statusCode": 301,
      "has": [
        {
          "type": "host",
          "value": "www.bemasmining.com"
        }
      ]
    }
  ]
}
